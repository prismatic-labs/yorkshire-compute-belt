---
import BaseLayout from "../components/BaseLayout.astro";
import { disclosureChecklist, formatBestPower, getSites } from "../lib/sites";
import { formatNumber, formatWaterUse } from "../lib/units";

const sites = getSites();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function cellClass(disclosed: boolean) {
  return disclosed ? "text-[var(--ink)]" : "text-[var(--muted)]";
}

function acresLabel(acres: number | undefined | null) {
  if (acres == null) return "Unknown";
  const digits = Number.isInteger(acres) ? 0 : acres < 10 ? 2 : 1;
  return `${formatNumber(acres, digits)} acres`;
}
---

<BaseLayout title="Sites" description="Sortable table of data centre sites across Yorkshire, the Humber, and Teesside.">
  <h1 class="font-display text-3xl m-0 tracking-tight">Sites</h1>
  <p class="text-[var(--muted)] mt-2 max-w-2xl">
    Full list of sites on the map: the power, land, and water figures behind the regional AI and cloud
    build-out. Each row links to more detail, including where each figure comes from.
  </p>
  <p class="text-sm text-[var(--muted)] mt-3 max-w-2xl">
    <strong class="text-[var(--ink)] font-semibold">Stated size</strong> is how large <em>this site</em> claims to be, in megawatts:
    the biggest size stated for that site if published, otherwise the grid connection applied for, otherwise the first stage only, otherwise the IT-equipment load.
    It is a size on paper for that scheme, not day-to-day electricity use, and not a regional total.
    Equal figures (two 1&nbsp;GW schemes) are joint maxima: neither outranks the other.
    <strong class="text-[var(--ink)] font-semibold"> Site area</strong> is land take in acres and what kind of land it is.
  </p>

  <div class="overflow-x-auto mt-8">
    <table class="w-full text-sm border-collapse" id="sites-table">
      <thead>
        <tr class="border-b border-[var(--ink)] text-left text-xs uppercase tracking-wider text-[var(--muted)]">
          <th class="py-2 pr-3"><button type="button" data-sort="name" class="sort-btn">Site</button></th>
          <th class="py-2 pr-3"><button type="button" data-sort="operator" class="sort-btn">Operator</button></th>
          <th class="py-2 pr-3"><button type="button" data-sort="status" class="sort-btn">Status</button></th>
          <th class="py-2 pr-3"><button type="button" data-sort="power" class="sort-btn">Stated size</button></th>
          <th class="py-2 pr-3">Water</th>
          <th class="py-2 pr-3"><button type="button" data-sort="land" class="sort-btn">Site area</button></th>
          <th class="py-2 pr-3">Land use</th>
          <th class="py-2"><button type="button" data-sort="reviewed" class="sort-btn">Reviewed</button></th>
        </tr>
      </thead>
      <tbody>
        {sites.map((f) => {
          const p = f.properties;
          const powerVal = p.power.max_proposed_mw?.value
            ?? p.power.grid_connection_mw?.value
            ?? p.power.phase_1_mw?.value
            ?? -1;
          return (
            <tr
              class="border-b border-[var(--line)]"
              data-name={p.name}
              data-operator={p.operator}
              data-status={p.status}
              data-power={powerVal}
              data-land={p.land.acres?.value ?? -1}
              data-reviewed={p.last_reviewed}
            >
              <td class="py-2.5 pr-3"><a href={`${base}/site/${p.id}`}>{p.name}</a></td>
              <td class="py-2.5 pr-3">{p.operator}</td>
              <td class="py-2.5 pr-3 capitalize">{p.status.replaceAll("_", " ")}</td>
              <td class="py-2.5 pr-3 font-tabular">{formatBestPower(p)}</td>
              <td class="py-2.5 pr-3 font-tabular">{formatWaterUse(p.water_litres_pa)}</td>
              <td class="py-2.5 pr-3 font-tabular">
                {acresLabel(p.land.acres?.value)}
              </td>
              <td class="py-2.5 pr-3">
                {p.land.land_type === "brownfield"
                  ? "ex-industrial / brownfield"
                  : p.land.land_type === "agricultural"
                    ? "farmland"
                    : "active industrial"}
              </td>
              <td class="py-2.5 font-tabular">{p.last_reviewed}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <section class="mt-14" id="disclosure">
    <h2 class="font-display text-xl m-0 tracking-tight">What each site discloses</h2>
    <p class="text-sm text-[var(--muted)] mt-2 max-w-2xl">
      Presence of a public figure only. Not a score: five separate yes/no answers, not a grade.
      “Energy source” means an on-record claim about where power comes from (for example renewables or heat reuse), not a verified supply mix.
    </p>

    <div class="overflow-x-auto mt-6">
      <table class="w-full text-sm border-collapse" id="disclosure-table">
        <thead>
          <tr class="border-b border-[var(--ink)] text-left text-xs uppercase tracking-wider text-[var(--muted)]">
            <th class="py-2 pr-3">Site</th>
            <th class="py-2 pr-3">Stated size (MW)</th>
            <th class="py-2 pr-3">Water use</th>
            <th class="py-2 pr-3">Power usage effectiveness</th>
            <th class="py-2 pr-3">Energy source claim</th>
            <th class="py-2">Load factor</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((f) => {
            const p = f.properties;
            const d = disclosureChecklist(p);
            return (
              <tr class="border-b border-[var(--line)]">
                <td class="py-2.5 pr-3"><a href={`${base}/site/${p.id}`}>{p.name}</a></td>
                <td class={`py-2.5 pr-3 font-tabular ${cellClass(d.power)}`}>{d.power ? "Yes" : "No"}</td>
                <td class={`py-2.5 pr-3 font-tabular ${cellClass(d.water)}`}>
                  {d.water ? "Yes" : d.waterClaimedZero ? "Claims zero" : "No"}
                </td>
                <td class={`py-2.5 pr-3 font-tabular ${cellClass(d.pue)}`}>{d.pue ? "Yes" : "No"}</td>
                <td class={`py-2.5 pr-3 font-tabular ${cellClass(d.energy_source)}`}>{d.energy_source ? "Yes" : "No"}</td>
                <td class={`py-2.5 font-tabular ${cellClass(d.load_factor)}`}>{d.load_factor ? "Yes" : "No"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-[var(--muted)] mt-3">
      Load factor is how much of peak capacity a site expects to use on average. No operator on this map publishes one.
    </p>
  </section>
</BaseLayout>

<style>
  .sort-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-transform: inherit;
    letter-spacing: inherit;
  }
  .sort-btn:hover { color: var(--ink); }
</style>

<script>
  const table = document.getElementById("sites-table");
  if (table) {
    const tbody = table.querySelector("tbody")!;
    let lastKey = "";
    let asc = true;
    table.querySelectorAll("[data-sort]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = (btn as HTMLElement).dataset.sort!;
        if (key === lastKey) asc = !asc;
        else { lastKey = key; asc = true; }
        const rows = [...tbody.querySelectorAll("tr")];
        rows.sort((a, b) => {
          const av = a.dataset[key] ?? "";
          const bv = b.dataset[key] ?? "";
          const an = Number(av);
          const bn = Number(bv);
          let cmp = Number.isFinite(an) && Number.isFinite(bn)
            ? an - bn
            : String(av).localeCompare(String(bv));
          return asc ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  }
</script>
